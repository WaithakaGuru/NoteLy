{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "prod": "npx prisma migrate deploy && npm run build && node dist/index.js",
    "pstudio": "prisma studio",
    "pinit": "prisma init",
    "pgenerate": "prisma generate --schema=./prisma/schema.prisma",
    "pmigrate": "prisma migrate dev",
    "pdeploy": "prisma migrate deploy",
    "start": "node dist/index.js",
    "dev": "npx tsx watch src/index.ts"
  },
  "author": "WaithakaGuru",
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.5.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.9.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3"
  }
}
